# 이 파일을 backend/.env 로 복사한 뒤 본인 로컬 값으로 채우세요. (.env 는 커밋되지 않습니다)

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=여기에_로컬_MySQL_비밀번호
MYSQL_DB=cortis

# offline = API 키 없이 해시 임베딩으로 파이프라인 검증 (기본)
# openai  = 실제 text-embedding-3-small 사용 (OPENAI_API_KEY 필요, 발표용 최종 데모에 권장)
EMBEDDING_BACKEND=offline
EMBEDDING_DIM=64

# 유사 코호트 top-k
COHORT_TOP_K=5

# 확정 이벤트가 이 개수 미만이면 '초기 데이터 부족' 신뢰도 표시
COLD_START_THRESHOLD=2
